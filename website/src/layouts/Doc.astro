---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import InstallButton from '../components/InstallButton.astro';
import { url } from '../consts';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  section?: 'guide' | 'page';
  slug?: string;
  intro?: string;
}

const { title, description, section = 'page', slug, intro } = Astro.props;
let guideNav: { slug: string; title: string; href: string }[] = [];

if (section === 'guide') {
  const entries = await getCollection('guide');
  guideNav = entries
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
    .map((entry) => ({
      slug: entry.id,
      title: entry.data.title,
      href: url(`/guide/${entry.id}/`),
    }));
}
---

<Base title={title} description={description}>
  <div class:list={['doc', section === 'guide' && 'doc--guide']}>
    <div class="shell doc__layout">
      {
        section === 'guide' && (
          <aside class="doc__side">
            <div class="doc__side-head">
              <p>Guide</p>
              <a href={url('/guide/')}>View all</a>
            </div>
            <nav aria-label="Guide chapters">
              {guideNav.map((item, index) => (
                <a
                  href={item.href}
                  class:list={['doc__link', slug === item.slug && 'is-active']}
                  aria-current={slug === item.slug ? 'page' : undefined}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {item.title}
                </a>
              ))}
            </nav>
            <InstallButton size="compact" class="doc__install" />
          </aside>
        )
      }

      <article class="doc__article">
        <header class="doc__head">
          <p class="eyebrow">{section === 'guide' ? 'YouTube Audio guide' : 'YouTube Audio'}</p>
          <h1>{title}</h1>
          {intro && <p class="doc__intro">{intro}</p>}
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
    </div>
  </div>
</Base>

<style>
  .doc {
    padding-block: var(--space-fluid-md);
  }

  .doc__layout {
    display: grid;
  }

  .doc:not(.doc--guide) .doc__article {
    width: min(100%, var(--layout-reading));
    margin-inline: auto;
  }

  .doc--guide .doc__layout {
    grid-template-columns: 15rem minmax(0, var(--layout-reading));
    justify-content: center;
    gap: var(--space-fluid-md);
    align-items: start;
  }

  .doc__side {
    position: sticky;
    top: calc(var(--header-height) + var(--space-5));
    padding: var(--space-4);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .doc__side-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2);
  }

  .doc__side-head p {
    color: var(--color-content);
    font-weight: 760;
  }

  .doc__side-head a {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .doc__side nav {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .doc__link {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .doc__link span {
    color: var(--color-content-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .doc__link:hover,
  .doc__link.is-active {
    background: var(--color-surface-accent);
    color: var(--color-content);
  }

  .doc__link.is-active {
    font-weight: 700;
  }

  .doc__side :global(.doc__install) {
    width: 100%;
    margin-top: var(--space-4);
  }

  .doc__article {
    min-width: 0;
  }

  .doc__head {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 0.0625rem solid var(--color-border);
  }

  .doc__head h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .doc__intro {
    max-width: 42rem;
    margin-top: var(--space-4);
    color: var(--color-content-muted);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  @media (max-width: 55rem) {
    .doc--guide .doc__layout {
      grid-template-columns: 1fr;
    }

    .doc__side {
      position: static;
    }

    .doc__side nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .doc__side nav {
      grid-template-columns: 1fr;
    }
  }
</style>
