---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InstallButton from '../../components/InstallButton.astro';
import { getCollection } from 'astro:content';
import { url } from '../../consts';

const icons: Record<string, string> = {
  install: 'download',
  audio: 'volume',
  blocking: 'shield',
  music: 'sliders',
  download: 'download',
  cleaner: 'sparkles',
  mobile: 'smartphone',
  settings: 'gear',
  faq: 'question',
};

const entries = (await getCollection('guide')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<Base
  title="Guide"
  description="Install YouTube Audio and learn its audio-only playback, blocking, YouTube Music, download, cleaner, mobile and privacy controls."
>
  <section class="guide-head">
    <div class="shell guide-head__grid">
      <div>
        <p class="eyebrow"><Icon name="book" size={15} /> Product guide</p>
        <h1>From first install to every optional control.</h1>
        <p class="lead">
          Start with Firefox desktop or Android, then learn only the features you want.
          Defaults, privacy boundaries and fallback behavior are called out along the way.
        </p>
      </div>
      <div class="guide-head__actions">
        <InstallButton size="large" />
        <a class="btn" href={url('/how-it-works/')}>How it works <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="guide-list" aria-labelledby="chapters-title">
    <div class="shell">
      <h2 id="chapters-title">Nine short chapters</h2>
      <ol>
        {
          entries.map((entry, index) => (
            <li>
              <a href={url(`/guide/${entry.id}/`)}>
                <span class="guide-card__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="guide-card__icon"><Icon name={icons[entry.id] ?? 'book'} size={21} /></span>
                <span class="guide-card__copy">
                  <strong>{entry.data.title}</strong>
                  <span>{entry.data.summary}</span>
                </span>
                <Icon name="arrow" size={18} class="guide-card__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .guide-head {
    padding-block: var(--space-fluid-md);
    border-bottom: 0.0625rem solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .guide-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-fluid-sm);
  }

  .guide-head h1 {
    max-width: 16ch;
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .guide-head .lead {
    margin-top: var(--space-4);
  }

  .guide-head__actions {
    display: grid;
    gap: var(--space-3);
  }

  .guide-list {
    padding-block: var(--space-fluid-md);
  }

  .guide-list h2 {
    margin-bottom: var(--space-6);
    font-size: var(--text-xl);
  }

  .guide-list ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }

  .guide-list li a {
    display: grid;
    min-height: 100%;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .guide-list li a:hover {
    transform: translateY(-0.125rem);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .guide-card__number {
    color: var(--color-content-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .guide-card__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .guide-card__copy {
    display: grid;
    gap: var(--space-1);
  }

  .guide-card__copy strong {
    color: var(--color-content);
    font-size: var(--text-md);
  }

  .guide-card__copy > span {
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .guide-card__arrow {
    color: var(--color-content-subtle);
  }

  @media (max-width: 48rem) {
    .guide-head__grid,
    .guide-list ol {
      grid-template-columns: 1fr;
    }

    .guide-head__actions {
      justify-items: start;
    }
  }

  @media (max-width: 28rem) {
    .guide-list li a {
      grid-template-columns: auto 1fr auto;
    }

    .guide-card__number {
      display: none;
    }
  }
</style>
