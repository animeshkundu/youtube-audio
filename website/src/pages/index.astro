---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InstallButton from '../components/InstallButton.astro';
import WindowFrame from '../components/WindowFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import { SITE, url } from '../consts';

const defaultFeatures = [
  'Audio-only playback',
  'Background play',
  'In-player artwork',
  'Ghost telemetry blocking',
  'Ad descriptor blocking',
  'Music loudness normalization',
];

const optionalFeatures = [
  'Sponsor and non-music skipping',
  'Five-band EQ',
  'Audio download',
  'Video quality cap',
  'Shorts, comments and recommendation cleaner',
];

const limits = [
  {
    icon: 'compass',
    title: 'Firefox only',
    text: 'Firefox 128+ on desktop and Firefox for Android are supported. Chrome, Edge and Safari are not.',
  },
  {
    icon: 'lock',
    title: 'Signed-out playback',
    text: 'The extension never uses your YouTube account or cookies. Videos that require a login play normally.',
  },
  {
    icon: 'lifebuoy',
    title: 'Fallback is a feature',
    text: 'Live or DVR streams, made-for-kids videos, age restrictions, members-only uploads and any failed lookup stay with normal YouTube.',
  },
  {
    icon: 'shield',
    title: 'Blocking is bounded',
    text: 'It prunes known ad descriptors and selected telemetry endpoints. It does not promise to remove every server-inserted ad.',
  },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow"><Icon name="headphones" size={15} stroke={2} /> Firefox desktop + Android</p>
        <h1 id="hero-title" class="hero__title">YouTube and YouTube Music. <span>Just the audio.</span></h1>
        <p class="hero__lead">
          YouTube Audio swaps the page player to a direct audio stream. It stops requesting new video
          segments, so listening uses less data and avoids video decoding your battery does not need.
        </p>
        <div class="cluster hero__actions">
          <InstallButton size="large" label="Add to Firefox — free" />
          <a class="btn btn--large" href="#experience">See it in action <Icon name="arrow" size={17} /></a>
        </div>
        <p class="hero__note">
          Firefox {SITE.minFirefox}+ · desktop and Android · signed-out use · open source
        </p>
      </div>

      <div class="hero__visual">
        <div class="hero__signal">
          <span class="hero__signal-dot"></span>
          Audio only is active
        </div>
        <WindowFrame
          src="/screenshots/popup-panel-active.png"
          alt="Extension popup confirming audio-only playback is active, with background play, ad blocking and Ghost mode enabled."
          width={320}
          height={384}
          eager={true}
        />
      </div>
    </div>
  </section>

  <section id="experience" class="section experience" aria-labelledby="experience-title">
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">What it is and who it is for</p>
        <h2 id="experience-title">Keep the player you know. Drop the picture you are not watching.</h2>
        <p>
          Built for mixes, podcasts, lectures and music playing in another tab or behind a locked phone.
          The YouTube timeline and controls remain; the extension changes the media source, not the whole player.
        </p>
      </header>

      <div class="experience__showcase">
        <article class="experience__main card">
          <div>
            <p class="eyebrow">Current-video status</p>
            <h3>It reports what actually happened</h3>
            <p>
              The popup distinguishes successful audio-only playback from a fallback. A live stream, for
              example, stays on normal YouTube instead of showing a misleading active state.
            </p>
          </div>
          <div class="experience__pair">
            <figure>
              <WindowFrame
                src="/screenshots/popup-panel-active.png"
                alt="Popup showing audio-only active for a supported video."
                width={320}
                height={384}
              />
              <figcaption><span class="status-dot status-dot--on"></span> Audio only</figcaption>
            </figure>
            <figure>
              <WindowFrame
                src="/screenshots/popup-panel-fallback.png"
                alt="Popup explaining that a live stream is playing normally instead of using audio-only mode."
                width={320}
                height={382}
              />
              <figcaption><span class="status-dot"></span> Normal playback</figcaption>
            </figure>
          </div>
        </article>

        <article class="experience__mobile card">
          <div>
            <p class="eyebrow">Made for listening</p>
            <h3>Settings on a narrow screen</h3>
            <p>
              The options page stacks its controls for a narrow Firefox window. Audio can keep playing
              when you switch apps or lock Android, while YouTube's own media session continues handling
              play, pause and seeking.
            </p>
          </div>
          <PhoneFrame
            src="/screenshots/options-mobile.png"
            alt="Mobile options screen with touch-friendly quick controls for audio-only and background playback."
          />
        </article>
      </div>

      <div class="feature-defaults">
        <div>
          <h3>On by default</h3>
          <ul>
            {defaultFeatures.map((feature) => <li><Icon name="check" size={16} /> {feature}</li>)}
          </ul>
        </div>
        <div>
          <h3>Available when you opt in</h3>
          <ul>
            {optionalFeatures.map((feature) => <li><Icon name="plus" size={16} /> {feature}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="savings" class="section savings" aria-labelledby="savings-title">
    <div class="shell savings__grid">
      <div class="savings__copy">
        <p class="eyebrow">Why it saves battery and bandwidth</p>
        <h2 id="savings-title">One audio stream instead of audio plus video.</h2>
        <p>
          On a successful switch, the page uses a direct audio format and stops requesting new video
          segments. The browser also has no video track to decode and paint while the tab sits out of sight.
          That is the saving: less media transferred, and less work performed.
        </p>
        <a href={url('/how-it-works/')}>Read the exact playback sequence <Icon name="arrow" size={16} /></a>
      </div>

      <div class="savings__proof">
        <article class="metric card">
          <span>Illustrative audio stream</span>
          <strong>58–72 MB / hour</strong>
          <p>128 kbit/s is about 58 MB per hour; 160 kbit/s is about 72 MB per hour.</p>
        </article>
        <article class="metric metric--mechanism card">
          <span>Measured repository signal</span>
          <strong>No new video segments</strong>
          <p>Observed during the successful audio-only hijack window in the project spike.</p>
        </article>
        <p class="savings__caveat">
          These figures are arithmetic examples, not a guaranteed saving. Actual audio formats vary,
          roughly 50–160 kbit/s in project research, and normal YouTube traffic returns during fallback.
          Battery benefit is not stated as a number because it has not been measured.
        </p>
      </div>
    </div>
  </section>

  <section id="install" class="section install" aria-labelledby="install-title">
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">Install in Firefox</p>
        <h2 id="install-title">One add-on, two supported places.</h2>
        <p>
          The same Mozilla Add-ons listing installs on Firefox desktop and Firefox for Android.
          Firefox 128 or newer is required.
        </p>
      </header>

      <div class="install__cards">
        <article class="install-card card">
          <span class="install-card__icon"><Icon name="compass" size={24} /></span>
          <p class="install-card__step">Desktop</p>
          <h3>Firefox on Windows, macOS or Linux</h3>
          <ol>
            <li>Open the Mozilla Add-ons listing in Firefox.</li>
            <li>Select <strong>Add to Firefox</strong> and approve the requested access.</li>
            <li>Open YouTube while signed out and play a supported video.</li>
          </ol>
          <InstallButton label="Install for Firefox desktop" />
        </article>

        <article class="install-card card">
          <span class="install-card__icon"><Icon name="smartphone" size={24} /></span>
          <p class="install-card__step">Android</p>
          <h3>Firefox for Android</h3>
          <ol>
            <li>Open this page in Firefox for Android.</li>
            <li>Use the same Mozilla Add-ons listing and confirm installation.</li>
            <li>Open YouTube or YouTube Music while signed out.</li>
          </ol>
          <InstallButton label="Install for Firefox Android" />
        </article>
      </div>

      <aside class="browser-note" aria-label="Browser support note">
        <Icon name="lifebuoy" size={21} />
        <div>
          <h3>Reading this in Chrome, Edge or Safari?</h3>
          <p>
            The add-on requires Firefox network APIs. Open this page in Firefox 128+ to install it.
            The install link stays available so you can copy or send it to the right browser.
          </p>
        </div>
        <InstallButton variant="secondary" label="Open Mozilla Add-ons" />
      </aside>

      <p class="alternate-install">
        Prefer a file? Regular release <code>.xpi</code> files are available on
        <a href={SITE.releases}>GitHub Releases</a>. Developers can also load a source build through
        <code>about:debugging</code>, but that temporary installation disappears when Firefox closes.
      </p>
    </div>
  </section>

  <section id="limits" class="section limits" aria-labelledby="limits-title">
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">What it does not do</p>
        <h2 id="limits-title">Clear boundaries, not fine print.</h2>
        <p>
          YouTube Audio is deliberately narrow: signed-out, credentialless audio playback that hands
          control back whenever it cannot work safely.
        </p>
      </header>
      <ul class="limits__grid">
        {
          limits.map((limit) => (
            <li class="limit-card card">
              <Icon name={limit.icon} size={22} />
              <h3>{limit.title}</h3>
              <p>{limit.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="privacy" class="section privacy" aria-labelledby="privacy-title">
    <div class="shell privacy__panel">
      <div class="privacy__intro">
        <p class="eyebrow">What it does with your data</p>
        <h2 id="privacy-title">No project analytics. No developer server. No YouTube login.</h2>
        <p>
          Extension requests use <code>credentials: 'omit'</code>. The project receives no playback,
          browsing or settings data, while the services providing the requested media still see the
          limited requests sent directly to them.
        </p>
        <a class="btn" href={url('/privacy/')}>Read the full privacy page <Icon name="arrow" size={16} /></a>
      </div>

      <dl class="data-list">
        <div>
          <dt>www.youtube.com</dt>
          <dd>Video ID, page visitor data and the ANDROID_VR client descriptor for the audio lookup.</dd>
        </div>
        <div>
          <dt>*.googlevideo.com</dt>
          <dd>The selected credentialless audio stream, or audio bytes for an optional download.</dd>
        </div>
        <div>
          <dt>i.ytimg.com</dt>
          <dd>The thumbnail used only as decorative artwork inside the page player.</dd>
        </div>
        <div>
          <dt>sponsor.ajay.app · optional</dt>
          <dd>
            Only after separate opt-in: the first 16 bits of SHA-256(video ID). Exact matching stays local.
          </dd>
        </div>
        <div>
          <dt>Your device</dt>
          <dd>Settings and redacted diagnostics stay local. Diagnostics are never transmitted.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section--compact final-cta" aria-labelledby="final-cta-title">
    <div class="shell final-cta__panel">
      <div>
        <p class="eyebrow">Ready to listen?</p>
        <h2 id="final-cta-title">Make the next YouTube tab audio only.</h2>
      </div>
      <InstallButton size="large" label="Add YouTube Audio to Firefox" />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - var(--header-height));
    align-items: center;
    padding-block: var(--space-fluid-sm);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.65fr);
    align-items: center;
    gap: var(--space-fluid-md);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    max-width: 18ch;
    margin-top: var(--space-4);
    font-size: var(--text-display);
    line-height: var(--leading-tight);
  }

  .hero__title span {
    color: var(--color-accent-strong);
  }

  .hero__lead {
    max-width: 39rem;
    margin-top: var(--space-5);
    color: var(--color-content-muted);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  .hero__note {
    margin-top: var(--space-4);
    color: var(--color-content-subtle);
    font-size: var(--text-sm);
  }

  .hero__visual {
    position: relative;
    width: min(100%, 25rem);
    justify-self: end;
  }

  .hero__visual::before {
    position: absolute;
    inset: -12% 0;
    z-index: -1;
    border-radius: var(--radius-round);
    background: var(--color-glow);
    content: '';
    filter: blur(3rem);
  }

  .hero__signal {
    position: absolute;
    top: calc(var(--space-4) * -1);
    left: calc(var(--space-4) * -1);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 0.0625rem solid var(--color-border-strong);
    border-radius: var(--radius-round);
    background: var(--color-surface-raised);
    color: var(--color-content);
    box-shadow: var(--shadow-md);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .hero__signal-dot,
  .status-dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-round);
    background: var(--color-content-subtle);
  }

  .hero__signal-dot,
  .status-dot--on {
    background: var(--color-status-success);
  }

  .experience {
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .experience__showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.75fr);
    gap: var(--space-5);
  }

  .experience__main,
  .experience__mobile {
    padding: var(--space-fluid-sm);
  }

  .experience__main h3,
  .experience__mobile h3 {
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
  }

  .experience__main > div > p:last-child,
  .experience__mobile > div > p:last-child {
    margin-top: var(--space-3);
    color: var(--color-content-muted);
  }

  .experience__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .experience__pair figure {
    min-width: 0;
    margin: var(--space-0);
  }

  .experience__pair figcaption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .experience__mobile {
    display: grid;
    align-content: space-between;
    justify-items: center;
    gap: var(--space-8);
  }

  .feature-defaults {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .feature-defaults > div {
    padding: var(--space-5);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .feature-defaults h3 {
    font-size: var(--text-md);
  }

  .feature-defaults ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) var(--space-0) var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }

  .feature-defaults li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-round);
    background: var(--color-surface-accent);
    color: var(--color-content);
    font-size: var(--text-sm);
  }

  .feature-defaults svg {
    color: var(--color-accent-strong);
  }

  .savings__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: var(--space-fluid-md);
  }

  .savings__copy h2 {
    max-width: 12ch;
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .savings__copy > p:not(.eyebrow) {
    margin-top: var(--space-5);
    color: var(--color-content-muted);
    font-size: var(--text-md);
  }

  .savings__copy > a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    color: var(--color-accent-strong);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }

  .savings__proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .metric {
    padding: var(--space-6);
  }

  .metric > span {
    color: var(--color-content-subtle);
    font-size: var(--text-xs);
    font-weight: 740;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .metric strong {
    display: block;
    margin-top: var(--space-4);
    color: var(--color-accent-strong);
    font-size: var(--text-2xl);
    line-height: var(--leading-heading);
  }

  .metric p {
    margin-top: var(--space-3);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .metric--mechanism {
    background: var(--color-surface-accent);
  }

  .savings__caveat {
    grid-column: 1 / -1;
    padding: var(--space-4) var(--space-5);
    border-left: 0.25rem solid var(--color-status-warning);
    border-radius: var(--radius-sm);
    background: var(--color-surface-status);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .install {
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .install__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .install-card {
    display: grid;
    justify-items: start;
    padding: var(--space-fluid-sm);
  }

  .install-card__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .install-card__step {
    margin-top: var(--space-5);
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 760;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .install-card h3 {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
  }

  .install-card ol {
    margin: var(--space-5) var(--space-0);
    padding-left: var(--space-5);
    color: var(--color-content-muted);
  }

  .install-card li {
    margin-block: var(--space-2);
    padding-left: var(--space-2);
  }

  .browser-note {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-status);
  }

  .browser-note > svg {
    color: var(--color-status-warning);
  }

  .browser-note h3 {
    font-size: var(--text-md);
  }

  .browser-note p {
    margin-top: var(--space-1);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .alternate-install {
    max-width: var(--layout-reading);
    margin: var(--space-5) auto var(--space-0);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .alternate-install a {
    color: var(--color-accent-strong);
    font-weight: 700;
    text-decoration: underline;
  }

  .alternate-install code {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-content);
    font-family: var(--font-mono);
  }

  .limits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }

  .limit-card {
    padding: var(--space-5);
  }

  .limit-card > svg {
    color: var(--color-accent-strong);
  }

  .limit-card h3 {
    margin-top: var(--space-5);
    font-size: var(--text-md);
  }

  .limit-card p {
    margin-top: var(--space-3);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .privacy {
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .privacy__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-fluid-md);
  }

  .privacy__intro h2 {
    max-width: 14ch;
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .privacy__intro > p:not(.eyebrow) {
    margin-top: var(--space-5);
    color: var(--color-content-muted);
  }

  .privacy__intro code {
    color: var(--color-content);
    font-family: var(--font-mono);
  }

  .privacy__intro .btn {
    margin-top: var(--space-6);
  }

  .data-list {
    margin: var(--space-0);
    border-top: 0.0625rem solid var(--color-border);
  }

  .data-list div {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 0.0625rem solid var(--color-border);
  }

  .data-list dt {
    color: var(--color-content);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .data-list dd {
    margin: var(--space-0);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .final-cta__panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-fluid-sm);
  }

  .final-cta h2 {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
  }

  @media (max-width: 64rem) {
    .limits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
