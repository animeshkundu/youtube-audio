---
import Logo from './Logo.astro';
import InstallButton from './InstallButton.astro';
import { NAV, SITE, url } from '../consts';
---

<header class="header">
  <div class="shell header__inner">
    <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}>
      <Logo size={28} />
      <span>YouTube Audio</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header__actions">
      <InstallButton size="compact" label="Install" class="header-install" />
      <details class="menu">
        <summary aria-label="Navigation menu">
          <span></span><span></span><span></span>
        </summary>
        <div class="menu__panel">
          <nav aria-label="Mobile">
            {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href={SITE.repo}>Source on GitHub</a>
          </nav>
          <InstallButton size="large" class="menu__install" />
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: var(--space-0);
    z-index: 50;
    border-bottom: 0.0625rem solid var(--color-border);
    background: color-mix(in srgb, var(--color-canvas) 92%, var(--color-transparent));
    backdrop-filter: blur(1rem);
  }

  .header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-content);
    font-size: var(--text-base);
    font-weight: 760;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .desktop-nav a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-content-muted);
    font-size: var(--text-sm);
    font-weight: 620;
  }

  .desktop-nav a:hover {
    background: var(--color-surface-subtle);
    color: var(--color-content);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .menu {
    position: relative;
    display: none;
  }

  .menu summary {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    list-style: none;
    place-content: center;
    gap: var(--space-1);
    border: 0.0625rem solid var(--color-border-strong);
    border-radius: var(--radius-round);
    background: var(--color-surface);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary span {
    width: 1rem;
    height: 0.125rem;
    border-radius: var(--radius-round);
    background: var(--color-content);
  }

  .menu__panel {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: var(--space-0);
    width: min(18rem, calc(100vw - (var(--gutter) * 2)));
    padding: var(--space-4);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-lg);
  }

  .menu__panel nav {
    display: grid;
  }

  .menu__panel nav a {
    padding: var(--space-3);
    border-bottom: 0.0625rem solid var(--color-border-subtle);
    color: var(--color-content);
    font-weight: 650;
  }

  .menu__panel :global(.menu__install) {
    width: 100%;
    margin-top: var(--space-4);
  }

  @media (max-width: 52rem) {
    .desktop-nav {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 24rem) {
    .brand span {
      display: none;
    }
  }
</style>
