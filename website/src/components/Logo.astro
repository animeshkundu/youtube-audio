---
interface Props {
  size?: number;
  class?: string;
}

const { size = 30, class: cls = '' } = Astro.props;
const bars = [
  { x: 8, height: 8 },
  { x: 11.6, height: 15 },
  { x: 15.2, height: 21 },
  { x: 18.8, height: 13 },
  { x: 22.4, height: 9 },
];
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="2" y="2" width="28" height="28" rx="8.5" fill="currentColor"></rect>
  <g class="mark-bars">
    {
      bars.map((bar) => (
        <rect
          x={bar.x}
          y={16 - bar.height / 2}
          width="2.5"
          height={bar.height}
          rx="1.25"
        />
      ))
    }
  </g>
</svg>

<style>
  svg {
    color: var(--color-accent);
  }

  .mark-bars {
    fill: var(--color-accent-ink);
  }
</style>
