---
import { url } from '../consts';

interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: cls = '' } = Astro.props;
---

<figure class:list={['phone-frame', cls]}>
  <div class="phone-frame__speaker" aria-hidden="true"></div>
  <div class="phone-frame__screen">
    <img src={url(src)} alt={alt} loading="lazy" decoding="async" width="500" height="835" />
  </div>
</figure>

<style>
  .phone-frame {
    position: relative;
    width: min(100%, 20rem);
    margin: var(--space-0);
    padding: var(--space-3);
    border: 0.0625rem solid var(--color-image-border);
    border-radius: var(--radius-xl);
    background: var(--gradient-image);
    box-shadow: var(--shadow-lg);
  }

  .phone-frame__speaker {
    width: var(--space-16);
    height: var(--space-1);
    margin: var(--space-1) auto var(--space-3);
    border-radius: var(--radius-round);
    background: var(--color-border);
  }

  .phone-frame__screen {
    overflow: hidden;
    border: 0.0625rem solid var(--color-image-border);
    border-radius: var(--radius-lg);
    background: var(--color-image-surface);
  }

  .phone-frame__screen img {
    width: 100%;
    height: auto;
  }
</style>
