---
import { url } from '../consts';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  crop?: boolean;
  class?: string;
}

const { src, alt, width, height, eager = false, crop = false, class: cls = '' } = Astro.props;
---

<figure class:list={['product-frame', crop && 'product-frame--crop', cls]}>
  <div class="product-frame__bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="product-frame__image">
    <img
      src={url(src)}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width={width}
      height={height}
    />
  </div>
</figure>

<style>
  .product-frame {
    position: relative;
    margin: var(--space-0);
    overflow: hidden;
    border: 0.0625rem solid var(--color-image-border);
    border-radius: var(--radius-lg);
    background: var(--gradient-image);
    box-shadow: var(--shadow-lg);
  }

  .product-frame__bar {
    display: flex;
    height: var(--space-8);
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    border-bottom: 0.0625rem solid var(--color-image-border);
    background: var(--color-image-surface);
  }

  .product-frame__bar span {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-round);
    background: var(--color-border);
  }

  .product-frame__image {
    overflow: hidden;
    background: var(--color-image-surface);
  }

  .product-frame__image img {
    width: 100%;
    height: auto;
  }

  .product-frame--crop .product-frame__image {
    max-height: 35rem;
  }

  .product-frame--crop img {
    object-fit: cover;
    object-position: top;
  }
</style>
