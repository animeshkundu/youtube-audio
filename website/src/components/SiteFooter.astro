---
import Logo from './Logo.astro';
import InstallButton from './InstallButton.astro';
import { FOOTER_LINKS, DISCLAIMER, SITE, url } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__top">
    <div class="footer__pitch">
      <a class="footer__brand" href={url('/')}>
        <Logo size={28} />
        <span>YouTube Audio</span>
      </a>
      <p>Turn a YouTube tab into a lighter audio player on Firefox desktop and Android.</p>
      <InstallButton label="Install from Mozilla Add-ons" />
    </div>

    <div class="footer__links">
      {
        FOOTER_LINKS.map((column) => (
          <nav aria-label={column.heading}>
            <p class="footer__heading">{column.heading}</p>
            {column.links.map((link) => (
              <a
                href={link.href}
                {...(link.href.startsWith('http')
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>

  <div class="shell footer__base">
    <p>{DISCLAIMER}</p>
    <p>© {year} Animesh Kundu · GPL-3.0 · Firefox {SITE.minFirefox}+</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-fluid-md);
    border-top: 0.0625rem solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) 1.3fr;
    gap: var(--space-fluid-md);
    padding-block: var(--space-fluid-md);
  }

  .footer__pitch {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .footer__pitch p {
    max-width: 34ch;
    color: var(--color-content-muted);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 760;
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .footer__links nav {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .footer__heading {
    color: var(--color-content-subtle);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .footer__links a {
    width: fit-content;
    color: var(--color-content-muted);
    font-size: var(--text-sm);
  }

  .footer__links a:hover {
    color: var(--color-accent-strong);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-5);
    border-top: 0.0625rem solid var(--color-border);
    color: var(--color-content-subtle);
    font-size: var(--text-xs);
  }

  .footer__base p:first-child {
    max-width: 64ch;
  }

  @media (max-width: 45rem) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
